chlight-right"] { transform-box: fill-box; transform-origin: 50% center; wi=
ll-change: opacity, transform; }
  .rwn2ia_MascotShadow { filter: blur(3px); opacity: 0; pointer-events: non=
e; transform-origin: 50% center; will-change: opacity, transform; backgroun=
d: var(--lightningcss-light,#00000040)var(--lightningcss-dark,#00000080); b=
order-radius: 999px; width: 62%; height: 8%; min-height: 2px; position: abs=
olute; top: 93%; left: 50%; transform: translate(-50%) translateY(0px) scal=
e(1); }
  .rwn2ia_GeneratedObjectLayer { z-index: 3; pointer-events: none; position=
: absolute; inset: 0px; overflow: visible; }
  .rwn2ia_GeneratedObjectLayer [data-mascot-generated-object] { filter: dro=
p-shadow(rgba(0, 0, 0, 0.18) 0px 1px 2px); opacity: 0; transform-origin: 50=
% center; will-change: opacity, transform; line-height: 1; display: block; =
position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) s=
cale(0.7); }
