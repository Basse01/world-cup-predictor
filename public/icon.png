w"])), html.mini-root body.mini:not([data-window-style=3D"new_page_overlay_=
view"]) { background-color: var(--bg-primary); }

html.mini-root:not(:has(body.mini[data-window-style=3D"sidebar_view"])) { -=
-user-chat-width: 50%; }

