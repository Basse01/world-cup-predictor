shadow) !important; }

.light body.mini[data-window-style=3D"sidebar_view"] { --sidechat-shadow: i=
nset 10px 0 10px -10px #00000026; }

.dark body.mini[data-window-style=3D"sidebar_view"] { --sidechat-shadow: in=
set 10px 0 10px -10px #ffffff26; }

