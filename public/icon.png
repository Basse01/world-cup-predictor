initial-value: 0%; }

@property --tw-mask-shimmer-duration { syntax: "<time>"; inherits: false; i=
nitial-value: 4s; }

@property --tw-mask-shimmer-delay { syntax: "<time>"; inherits: false; init=
ial-value: 0s; }

@keyframes mask-shimmer-offset-move {=20
  0% { --mask-shimmer-offset: 0%; }
  100% { --mask-shimmer-offset: 100%; }
}

@supports (animation-timeline:scroll()) {
  @keyframes scroll-shadow-reveal {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}
  @keyframes scroll-shadow-detect {=20
  0%, 100% { --can-scroll: ; }
}
  .horizontal-scroll-shadow-container, .vertical-scroll-shadow-container { =
animation-duration: auto; animation-timing-function: linear; animation-dela=
y: 0s; animation-iteration-count: 1; animation-direction: normal; animation=
-fill-mode: none; animation-play-state: running; animation-name: scroll-sha=
dow-detect; animation-range: normal; animation-timeline: --scroll-shadow !i=
mportant; }
  .horizontal-scroll-shadow-container::before, .horizontal-scroll-shadow-co=
ntainer::after, .vertical-scroll-shadow-container::before, .vertical-scroll=
