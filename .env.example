# Copy to .env.local and fill in. Never commit real values.

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key. Safe in the browser: the database enforces who may write what.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key. Server only (cron, admin routes). Bypasses RLS: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Match data (api-football.com / API-Sports) ──────────────────────────────
# Needed by /api/cron/sync-matches and the admin backfill. Without it the sync
# returns 500 and everything else keeps working.
API_FOOTBALL_KEY=your-api-sports-key

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret the scheduler sends as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# ── Web push (optional) ──────────────────────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
# Leave empty to run without push notifications; the app builds and runs fine.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: an email (mailto: is added) or an https URL.
VAPID_SUBJECT=you@example.com
